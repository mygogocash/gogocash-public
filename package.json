{
  "name": "gogocash-solana-payout",
  "version": "0.1.0",
  "private": true,
  "description": "GoGoCash hackathon slice: pay approved shopping cashback as a USDC stablecoin transfer on Solana.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "admin": "node scripts/admin.ts",
    "check:fixtures": "node scripts/contract/gen-fixtures.mjs --check",
    "check:workflows": "node scripts/check-workflows.ts",
    "codama": "node scripts/codama.ts idl/gogocash_cashback.devnet.json",
    "gen:fixtures": "node scripts/contract/gen-fixtures.mjs",
    "keygen": "node scripts/keygen.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:consumer": "tsc -p tsconfig.consumer.json --noEmit",
    "verify:devnet": "node scripts/verify-devnet.ts"
  },
  "dependencies": {
    "@solana-program/compute-budget": "0.19.0",
    "@solana-program/token": "0.17.0",
    "@solana/kit": "8.3.0"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "1.5.6",
    "@codama/renderers-js": "2.5.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "5.0.2"
  }
}
